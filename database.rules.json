{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        "chat": {
          "$msg": {
            ".validate": "newData.hasChildren(['t', 'ts']) && newData.child('t').isString() && newData.child('t').val().length <= 200"
          }
        }
      }
    },
    "secrets": {
      "$code": {
        ".read": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
        ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid"
      }
    },
    "hands": {
      "$code": {
        ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('rooms').child($code).child('meta/host').val() === auth.uid)"
        }
      }
    },
    "seasons": {
      "$month": {
        ".read": "auth != null",
        ".indexOn": [
          "pts"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['n', 'pts']) && newData.child('pts').isNumber()"
        }
      }
    },
    "daily": {
      "$date": {
        ".read": "auth != null",
        ".indexOn": [
          "g"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.hasChildren(['n', 'g']) && newData.child('g').isNumber()"
        }
      }
    }
  }
}