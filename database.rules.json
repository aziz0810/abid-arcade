{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        "chat": {
          "$msg": {
            ".validate": "newData.hasChildren(['t', 'ts']) && newData.child('t').isString() && newData.child('t').val().length <= 200"
          }
        }
      }
    },
    "secrets": {
      "$code": {
        ".read": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
        ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid"
      }
    },
    "hands": {
      "$code": {
        ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('rooms').child($code).child('meta/host').val() === auth.uid)"
        }
      }
    },
    "seasons": {
      "$month": {
        ".read": "auth != null",
        ".indexOn": [
          "pts"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['n', 'pts']) && newData.child('pts').isNumber()"
        }
      }
    },
    "daily": {
      "$date": {
        ".read": "auth != null",
        ".indexOn": [
          "g"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.hasChildren(['n', 'g']) && newData.child('g').isNumber()"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "fcodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
      }
    },
    "freq": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".read": "auth != null && auth.uid === $from",
          ".write": "auth != null && (auth.uid === $from || (auth.uid === $to && !newData.exists()))"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$f": {
          ".write": "auth != null && (auth.uid === $uid || (auth.uid === $f && (!newData.exists() || root.child('freq').child($f).child($uid).exists())))"
        }
      }
    },
    "invites": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || (auth.uid === $to && !newData.exists()))"
        }
      }
    },
    "lobby": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && (root.child('rooms').child($code).child('meta/host').val() === auth.uid || !root.child('rooms').child($code).exists())"
      }
    }
  }
}